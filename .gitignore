# Dependencies, compiled site, guest images, and local build caches
/node_modules/
/dist/
/.build/
/public/vm/
/.test-results/
/release/
/coverage/
/.cache/
/.wrangler/
.venv/
__pycache__/
*.py[cod]

# Local credentials and machine-specific configuration (examples are publishable)
.env
.env.*
!.env.example
!.env.*.example
.dev.vars
.dev.vars.*
!.dev.vars.example
/.aws/
/.cloudflare/
*.pem
*.key
*.p12
*.pfx
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
**/.terraform/

# Local editor, OS, and temporary files
.DS_Store
._*
Thumbs.db
Desktop.ini
/.idea/
/.vscode/
*.swp
*.swo
*~
*.log
*.tmp

# LaTeX intermediates; keep the authored .tex source
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
*.out
