# Copy to .env.cloudflare (ignored), fill in values, and export in your shell.
# Separate bucket-scoped R2 credentials for staging and production are preferred.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Required only for staging. Use the email on your Cloudflare login.
CLOUDFLARE_ACCESS_APP_ID=
STAGING_ACCESS_EMAIL=
