CONFIG_64BIT=n
CONFIG_X86_32=y
CONFIG_M686=y
CONFIG_M486=n
CONFIG_X86_PAE=n
CONFIG_SMP=n
CONFIG_LOCALVERSION="-personal"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_KERNEL_XZ=y
CONFIG_KERNEL_GZIP=n
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=2
CONFIG_SERIAL_8250_RUNTIME_UARTS=2
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_FUTEX=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
# musl uses the time32 ppoll syscall for ordinary terminal input timeouts.
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_KALLSYMS=n
CONFIG_MODULES=n
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_DUMMY=y
CONFIG_ETHERNET=n
CONFIG_WLAN=n
CONFIG_WIRELESS=n
CONFIG_BLOCK=n
CONFIG_VT=n
CONFIG_DEBUG_KERNEL=n
CONFIG_HZ_100=y
CONFIG_HZ=100
